    "dependencies": { "cs_ui": { "path": "../cs/cs_ui" } }
  },
  "pubspec_git": {
    "dependencies": {
      "cs_ui": { "git": { "url": "https://github.com/bryanpeng-777/cs_ui.git", "ref": "main" } }
    }
  },
  "dependencies": ["cs-ui"],
  "conflicts": [],
  "verify_points": ["G4"],
  "presets": ["full"]
}
